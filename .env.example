# =============================================================================
# LIFEQUEST — environment variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# =============================================================================

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used ONLY if you later add admin/service-role operations in
# server-only files (e.g. a cron job). The current codebase does not import
# this anywhere — every mutation goes through RLS + the complete_quest /
# purchase_item RPCs instead. Do not expose this to the client, ever.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables the Claude-backed AI Quest Forge provider. If unset, the
# app automatically falls back to the built-in heuristic quest generator —
# the feature (and the rest of the app) works fully without this key.
ANTHROPIC_API_KEY=
